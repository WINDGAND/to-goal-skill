{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node integrations/cursor/hooks/to-goal-gate.js",
        "matcher": "Write|StrReplace|EditNotebook|Delete|Shell",
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node integrations/cursor/hooks/to-goal-gate.js",
        "matcher": "skills\\s+add|npx\\s+skills",
        "failClosed": false
      }
    ]
  }
}
